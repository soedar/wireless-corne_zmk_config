#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Dvorak";
            bindings = <
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P          &kp Y      &kp F    &kp G      &kp C  &kp R  &kp L  &kp SLASH
&kp LGUI   &kp A          &kp O      &kp E       &kp U          &kp I      &kp D    &kp H      &kp T  &kp N  &kp S  &kp MINUS
&kp LCTRL  &kp SEMICOLON  &kp Q      &kp J       &kp K          &kp X      &kp B    &kp M      &kp W  &kp V  &kp Z  &kp RIGHT_ALT
                                     &kp LSHIFT  &kp BACKSPACE  &kp ESC    &kp RET  &kp SPACE  &mo 2
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&bootloader  &trans        &trans        &trans        &trans        &trans          &trans  &kp F7  &kp F8  &kp F9  &kp F10  &soft_off
&sys_reset   &trans        &trans        &trans        &trans        &trans          &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                                         &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans    &kp LBKT  &kp UP    &kp RBKT   &kp GRAVE    &kp BSLH    &kp N7  &kp N8  &kp N9  &kp N0     &trans
&trans  &kp LPAR  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RPAR     &trans      &kp N4  &kp N5  &kp N6  &trans     &trans
&trans  &trans    &trans    &trans    &trans     &trans       &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
                            &trans    &kp DEL    &tog 1       &trans      &trans  &trans
            >;
        };
    };
};
